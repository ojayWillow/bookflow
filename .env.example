# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# (Server-only — never expose on the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public app URL (used for booking page slug previews and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Domain verified in Resend — emails are sent from noreply@<this-domain>
RESEND_FROM_DOMAIN=yourdomain.com

# REQUIRED — secret used to HMAC-sign customer cancellation links.
# The booking API crashes on startup if this is missing.
# Generate one with: openssl rand -hex 32
CANCEL_TOKEN_SECRET=your-random-secret-here
